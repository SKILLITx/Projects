# ── Required ──────────────────────────────────────────────────────────────
# Groq API key. Get a free one at https://console.groq.com/keys
GROQ_API_KEY=

# ── Security (optional) ───────────────────────────────────────────────────
# Set a value to require an X-API-Key header on every endpoint.
# Leave empty for a friction-free local demo.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Upload limits ─────────────────────────────────────────────────────────
MAX_FILES=10
MAX_FILE_MB=50
MAX_BUNDLE_MB=150

# ── Sessions ──────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# ── Retrieval ─────────────────────────────────────────────────────────────
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SESSION_TOP_K=6
CORPUS_TOP_K=6
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=5

# ── Generation ────────────────────────────────────────────────────────────
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=120

# ── Rate limiting ─────────────────────────────────────────────────────────
# Defaults match the Groq free tier. Raise these on a paid plan.
TOKENS_PER_MINUTE=12000
REQUESTS_PER_MINUTE=28
EST_TOKENS_PER_QUERY=1600
MAX_RETRIES=4
RETRY_BASE_DELAY_S=2.0
CHECKLIST_WORKERS=3

# ── OCR ───────────────────────────────────────────────────────────────────
# Leave blank to auto-detect. On Windows, point at tesseract.exe if not on PATH.
TESSERACT_CMD=
OCR_DPI=300
OCR_LANGUAGES=urd+eng

LOG_LEVEL=INFO
