# SIS Academic Automation — local controlled-pilot environment
# Copy this file to .env by running scripts/Initialize-Environment.ps1.
# Never commit .env. Never paste its secret values into chat, tickets or logs.

SIS_PROJECT_NAME=sis-academic-automation
SIS_RUNTIME_DIR=.runtime
SIS_START_TIMEOUT_SECONDS=120
SIS_PUBLIC_TUNNEL_ENABLED=true

# Exact compatibility target required by the project brief.
N8N_EXPECTED_VERSION=2.4.0
N8N_HOST=localhost
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_PATH=/
N8N_USER_FOLDER=.runtime/n8n-user
N8N_ENCRYPTION_KEY=GENERATED_LOCALLY_BY_INITIALIZE_ENVIRONMENT
N8N_PROXY_HOPS=1
WEBHOOK_URL=
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# ngrok stores its auth token in the user's ngrok configuration, not in this file.
NGROK_COMMAND=ngrok
NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
NGROK_DOMAIN=

# Reserved for later phases. Keep placeholders until the relevant setup phase.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_IN_PHASE_2_OR_3
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SIDE_IN_PHASE_2
GOOGLE_WORKSPACE_CREDENTIAL_NAME=Google Workspace OAuth
GMAIL_SENDER_CREDENTIAL_NAME=Gmail Official Sender

# Phase 4 Wave 1 — Google queue and notification settings.
# Obtain the four Google IDs with google/provisioning/SIS-Wave1ConfigHelper.gs.
SIS_STUDENT_PROFILE_RESPONSE_SHEET_ID=REPLACE_WITH_GOOGLE_SPREADSHEET_ID
SIS_STUDENT_PROFILE_QUEUE_TAB_ID=REPLACE_WITH_AUTOMATION_QUEUE_GID
SIS_ENROLLMENT_RESPONSE_SHEET_ID=REPLACE_WITH_GOOGLE_SPREADSHEET_ID
SIS_ENROLLMENT_QUEUE_TAB_ID=REPLACE_WITH_AUTOMATION_QUEUE_GID
SIS_NOTIFICATION_BATCH_SIZE=20

SIS_MARK_CORRECTION_RESPONSE_SHEET_ID=
SIS_MARK_CORRECTION_QUEUE_TAB_ID=

SIS_TRANSCRIPT_DRIVE_FOLDER_ID=
